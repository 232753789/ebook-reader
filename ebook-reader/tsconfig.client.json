{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "tsBuildInfoFile": "lib/tsconfig.client.tsbuildinfo"
  },
  "files": [
    "src/client/EpubView.tsx",
    "src/client/EbookReaderPanel.tsx",
    "src/client/LibraryPanel.tsx",
    "src/client/LibraryPanelIcon.tsx",
    "src/client/PdfView.tsx",
    "src/client/ReaderView.tsx",
    "src/client/api.ts",
    "src/client/book.ts",
    "src/client/contract.ts",
    "src/client/epub-document.ts",
    "src/client/epub-lines.ts",
    "src/client/index.ts",
    "src/client/library-controller.ts",
    "src/client/locales.ts",
    "src/client/observable.ts",
    "src/client/pdf-document.ts",
    "src/client/pdf-lines.ts",
    "src/client/reader-controller.ts",
    "src/client/reading-text.ts",
    "src/client/speech-player.ts",
    "src/client/stores.ts",
    "src/css-modules.d.ts",
    "src/types.ts",
    "src/standalone-shims.d.ts"
  ]
}
